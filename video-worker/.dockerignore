# video-worker/.dockerignore — LOCK L7.1
#
# Without this the build context was 602 MB across 14,716 files, almost all of
# it the local `venv/`. That context is uploaded to the builder on EVERY deploy,
# so it was paid for on every push — and the venv is actively wrong to ship:
# it holds Windows-built wheels for a Linux image that runs
# `pip install -r requirements.txt` anyway.

# Local virtualenvs — rebuilt inside the image from requirements.txt.
venv/
.venv/
env/
ENV/

# Python build artefacts.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Test and tooling caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets never belong in an image layer. They are set as Fly secrets and
# injected at runtime; a .env copied into the image would persist in the layer
# history even after being deleted in a later step.
.env
.env.*
!.env.example

# Scratch space the worker creates at runtime; WORKER_TEMP_DIR points at the
# mounted volume in production.
tmp/
temp/
/tmp/video-engine/

# Local logs and editor noise.
*.log
.DS_Store
.idea/
.vscode/

# Deploy config is read by flyctl, not needed inside the image.
fly.toml
