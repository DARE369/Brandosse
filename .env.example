# =============================================================================
# ENV REFERENCE — copy relevant sections to the correct file
# =============================================================================
#
# This file is committed to git. NEVER put real secrets here.
# Real values live in THREE places:
#
#  1. .env.local          — Next.js app (API routes, server components)
#  2. Supabase secrets    — Edge functions only (set via: npx supabase secrets set KEY=value)
#  3. video-worker/.env   — Python video worker
#
# Variables marked [Supabase] are set ONLY via `npx supabase secrets set`.
# They are NOT read by the Next.js app and do not belong in .env.local.
# Variables marked [Both] need to be set in .env.local AND Supabase secrets.
#
# =============================================================================


# =============================================================================
# SECTION 1 — Browser-safe public config (.env.local)
# =============================================================================
# Safe to expose in the browser. Must start with NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_APP_URL="https://yourapp.com"

# Feature flags
NEXT_PUBLIC_ENABLE_PROMPT_SUGGESTIONS_EDGE_IN_DEV="false"

# (NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY removed 2026-08-22 — nothing loads
#  Stripe.js on the client. Checkout is a server-side redirect to a
#  checkout_url, so the publishable key was never needed.)


# =============================================================================
# SECTION 2 — Next.js server secrets (.env.local)
# =============================================================================
# Server-only. Read by API routes and server components. Never sent to browser.

# Supabase (auto-available in edge functions — only needed here for API routes)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI providers [Both — also set in Supabase secrets for edge functions]
GROQ_API_KEY="gsk_..."       # get from console.groq.com/keys
GROQ_MODEL=""                # optional edge/app override
ANTHROPIC_API_KEY=""         # get from console.anthropic.com
ANTHROPIC_MODEL="claude-sonnet-5"   # Pin explicitly — never rely on the code default,
                                    # and never use a -latest alias (LOCK L4.7).
DEFAULT_AI_MODEL=""          # optional: anthropic/groq preference for edge LLM helper
ANTHROPIC_TITLE_MODEL=""     # optional: cheaper model just for naming sessions
                             # (app/api/session-title). Falls back to a pinned default.
FAL_API_KEY=""               # get from fal.ai/dashboard — REQUIRED for image + video generation

# Zernio unified publishing API [Both — get from zernio.com dashboard → Settings → API Keys]
# The only real-publish provider. Covers 15 platforms via one OAuth connect +
# one publish call, no per-platform developer-app approval needed.
ZERNIO_API_KEY=""

# Media generation is fal.ai ONLY. Freepik, Magnific, Pollinations, Replicate
# and Gemini keys were all removed on 2026-08-22: no code read them, and every
# generation on record used fal-ai. See generateImage/index.ts ("Replaces:
# Magnific + Pollinations").

# Email [Both — also set in Supabase secrets]
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Cron job auth — protects /api/cron/* routes
CRON_SECRET="generate-a-random-string-here"

# Video worker integration
VIDEO_WORKER_WEBHOOK_SECRET=""
WORKER_WEBHOOK_URL="http://localhost:8001"

# Video engine mock flags (set to "false" in production)
# Only the payments flag is real. The worker reads its own WORKER_USE_MOCK_*
# variables, so VIDEO_ENGINE_USE_MOCK_ANTHROPIC/REPLICATE were read by nothing.
VIDEO_ENGINE_USE_MOCK_PAYMENTS="true"

# Payment server secrets. Stripe is the ONLY payment integration in the code —
# there is no Paystack code anywhere, so PAYSTACK_* was aspiration, not config.
# The HOURLY_RATE pair belonged to a different product entirely.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# (PRICE_MANAGEMENT_PASSWORD and ASSESSMENT_REVIEW_REQUIRED removed 2026-08-22 —
#  leftovers from a different product, read by nothing here.)


# =============================================================================
# SECTION 3 — Supabase edge function secrets only
# =============================================================================
# Set with: npx supabase secrets set KEY=value
# These are NOT read by Next.js. Do not add them to .env.local.
#
# Check current secrets: npx supabase secrets list
#
# Already set in Supabase (auto-managed — do not touch):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   SUPABASE_DB_URL, SUPABASE_JWKS, SUPABASE_PUBLISHABLE_KEYS,
#   SUPABASE_SECRET_KEYS
#
# Set these manually if not already configured:

# AI providers (edge functions)
# GROQ_API_KEY="gsk_..."         ← same key as Section 2
# GROQ_MODEL=""                  ← optional model override
# ANTHROPIC_API_KEY=""           ← same key as Section 2
# ANTHROPIC_MODEL=""             ← optional: override default claude model (e.g. claude-3-5-haiku-latest)
# DEFAULT_AI_MODEL=""            ← optional provider preference: anthropic or groq

# Platform publishing credentials (edge functions)
# ZERNIO_API_KEY=""              ← same key as Section 2, used by publish-post

# Email (edge functions)
# RESEND_API_KEY=""              ← same key as Section 2
# RESEND_FROM_EMAIL=""
# FROM_EMAIL="noreply@yourapp.com"
# FROM_NAME="Your App Name"

# App URL for edge function redirects
# APP_URL="https://yourapp.com"
# SITE_URL="https://yourapp.com"
# PUBLIC_APP_URL="https://yourapp.com"


# =============================================================================
# SECTION 4 — Python video worker (video-worker/.env)
# =============================================================================
# Copy this block into video-worker/.env. Not read by Next.js.

# WORKER_SUPABASE_URL="https://your-project.supabase.co/rest/v1/"
# WORKER_SUPABASE_SERVICE_KEY="your-service-role-key"
# WORKER_WEBHOOK_SECRET=""           # Must match VIDEO_WORKER_WEBHOOK_SECRET above
# WORKER_ALLOWED_ORIGINS=""          # Comma-separated app origins allowed to POST
#                                    # source video to /upload. Browsers upload
#                                    # straight to the worker, so a missing or wrong
#                                    # value blocks every upload at CORS.
# FLY_APP_NAME=""                    # Injected by Fly at runtime, never set by hand.
#                                    # The worker pings its own public URL while a job
#                                    # runs so the proxy does not idle-stop the machine
#                                    # mid-render (video-worker/poller.py). Absent locally,
#                                    # where the keepalive is correctly a no-op.
# WORKER_ALLOW_UPSCALE="false"       # Render clips larger than the source crop.
#                                    # Costs ~7x the encoding time on a 720p source
#                                    # and adds no detail — only matches the
#                                    # platforms' preferred 1080x1920.
# WORKER_REAPER_INTERVAL_SECONDS="180"
#                                    # How often the stuck-job reaper re-runs while the
#                                    # worker is up (video-worker/config.py:60). Startup-only
#                                    # recovery cannot rescue a job stranded by a machine stop
#                                    # whose restart happened before the threshold elapsed —
#                                    # which is what stranded job 2cdf61cd on 2026-09-04.
# WORKER_GROQ_API_KEY=""             # Whisper transcription (stages/transcribe.py).
#                                    # WITHOUT THIS, CLIPPING CANNOT RUN.
# WORKER_YOUTUBE_COOKIES=""          # yt-dlp cookie jar for age/bot-gated sources
#                                    # (stages/download.py). Also gates clipping in
#                                    # practice — the 10 live download failures.
# WORKER_ANTHROPIC_API_KEY=""        # Can share with main ANTHROPIC_API_KEY
# WORKER_REPLICATE_API_TOKEN=""      # Declared by config.py but NO worker stage
#                                    # imports replicate — leave unset.
# GOOGLE_FONTS_API_KEY=""            # Google Fonts Developer API key, for the EDGE
#                                    # runtime (supabase/functions/_shared/fonts.ts).
#                                    # Without it the design compositor cannot download
#                                    # the brand typeface, so generated graphics fall
#                                    # back to the plain AI background with the reason
#                                    # recorded on the generation — text is never drawn
#                                    # in a substitute face, and never drawn blank.
#                                    # WORKER_GOOGLE_FONTS_API_KEY is accepted as a
#                                    # fallback so one key can serve both.
# WORKER_GOOGLE_FONTS_API_KEY=""     # Google Fonts Developer API key. OPTIONAL.
#                                    # Without it the renderer uses its default
#                                    # face and logs that a brand font was asked
#                                    # for and not applied — clips still render.
#                                    # With it, font_display.family from the brand
#                                    # kit is downloaded as TTF and used for both
#                                    # the hook overlay and burned-in captions.
#                                    # Get one: console.cloud.google.com -> enable
#                                    # "Web Fonts Developer API" -> create API key.

# Worker runtime flags
# WORKER_USE_MOCK_ANTHROPIC="true"   # Set to "false" in production
# WORKER_USE_MOCK_REPLICATE="true"   # Set to "false" in production

# Worker tuning (defaults are fine for most setups)
# WORKER_TEMP_DIR="/tmp/video-engine"
# WORKER_MAX_CONCURRENT_JOBS="3"
# WORKER_POLL_INTERVAL_SECONDS="5"
# WORKER_STUCK_JOB_THRESHOLD_MINUTES="30"
# WORKER_PORT="8001"
# WORKER_LOG_LEVEL="INFO"


# =============================================================================
# SECTION 5 — Local tooling (.env)
# =============================================================================
# Only used by Prisma and local DB tools. Not read by Next.js or edge functions.

# DATABASE_URL=""


# =============================================================================
# SECTION 6 - Browser E2E validation (.env.local or CI env)
# =============================================================================
# Used only by Playwright tests. Do not commit real credentials.
#
# E2E_BASE_URL="http://localhost:3001"
# E2E_USER_EMAIL=""
# E2E_USER_PASSWORD=""
# E2E_ADMIN_EMAIL=""
# E2E_ADMIN_PASSWORD=""
# E2E_ORG_EMAIL=""
# E2E_ORG_PASSWORD=""
# E2E_ORG_ID=""
# E2E_PUBLISHED_POST_ID=""   # a published post owned by E2E_USER_EMAIL (copy-review.spec.js)
#
# Set E2E_REQUIRE_AUTH="1" in CI when authenticated journeys must run.

# Signs the OAuth connect state so the social connect callbacks can establish
# identity from a value only this server could mint (LOCK L1.6). Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUIRED — the connect flow fails closed without it.
OAUTH_STATE_SECRET=""

# =============================================================================
# SECTION 7 — Social platform OAuth (.env.local AND Supabase secrets)
# =============================================================================
# Direct per-platform OAuth. Replaces the Zernio unified API entirely.
#
# WHY BOTH ENVIRONMENTS: Next.js API routes run the authorization-code
# exchange; Supabase edge functions run token refresh and the publish
# adapters. Both need the client credentials. Mirror every value with:
#   npx supabase secrets set META_APP_SECRET=...
#
# SETUP: see PLATFORM-CREDENTIALS-SETUP.md for what to create in each
# platform's dashboard, which redirect URI to register, and the review
# gates that decide who can actually publish.
#
# NONE of these are NEXT_PUBLIC_. A client secret in the browser bundle is a
# full account-takeover primitive — scripts/check-env-security.cjs enforces it.

# ── Encryption at rest for platform tokens ──────────────────────────────────
# Platform access/refresh tokens are long-lived credentials to somebody's
# real social account. They are encrypted with this key before they touch
# the database, and decrypted only inside service-role edge functions.
# 32 bytes, base64. Rotating it invalidates every stored token (every user
# must reconnect), so treat it as permanent.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED before the first real token is stored.
TOKEN_ENCRYPTION_KEY=""

# ── Meta — Facebook Pages + Instagram (ONE app covers both) ─────────────────
# developers.facebook.com → My Apps → Create App → type "Business".
# Instagram professional accounts are reached THROUGH Facebook Login, so one
# app, one OAuth client, one redirect URI serves both platform tiles.
# Redirect URI to register: {APP_URL}/api/auth/social/meta/callback
META_APP_ID=""
META_APP_SECRET=""
# Pin the Graph API version explicitly. Meta deprecates versions on a ~2-year
# clock and an unversioned call silently follows the default forward — the same
# class of defect as a -latest model alias (LOCK L4.7).
META_GRAPH_VERSION="v21.0"

# ── TikTok — Content Posting API ────────────────────────────────────────────
# developers.tiktok.com → Manage apps. Add the "Content Posting API" product.
# HTTPS ONLY — TikTok rejects localhost redirect URIs, so local development
# needs a tunnel (see the setup doc).
# Redirect URI to register: {APP_URL}/api/auth/social/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# ── LinkedIn — member posting (+ optional company pages) ────────────────────
# linkedin.com/developers → Create app (requires an associated Company Page).
# "Share on LinkedIn" is self-serve and needs no review; company-page posting
# needs the Community Management API.
# Redirect URI to register: {APP_URL}/api/auth/social/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Pin the versioned-API date (YYYYMM). Every /rest/* call sends it as the
# LinkedIn-Version header. LinkedIn sunsets versions on a published schedule
# (Marketing 202508 dies 2026-08-17), so a pinned value fails loudly on a known
# date instead of drifting under a working integration — same reasoning as
# META_GRAPH_VERSION and LOCK L4.7's ban on `-latest` aliases.
LINKEDIN_VERSION="202607"

# ── YouTube — Google Cloud OAuth client ─────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# → "Web application". Enable the "YouTube Data API v3" on the project first.
# NOT the same thing as GOOGLE_FONTS_API_KEY in Section 4 — that is an API key
# for a public endpoint; this is an OAuth client acting on a user's behalf.
# Redirect URI to register: {APP_URL}/api/auth/social/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ── Google SIGN-IN (Google Identity Services) ───────────────────────────────
# The SAME client ID as GOOGLE_OAUTH_CLIENT_ID above — one project, one consent
# brand. NEXT_PUBLIC_ on purpose: a client ID is public by design (it is printed
# in every authorize URL); the SECRET above must never be. Allow-listed in
# scripts/check-env-security.cjs.
# This variable IS the switch: unset, sign-in uses the Supabase redirect and
# Google's chooser reads "to continue to <project>.supabase.co". Set it ONLY
# after the client's "Authorized JavaScript origins" list this app's origin —
# otherwise Google refuses the origin, and users get a ~6s blank before the
# redirect button appears. Verify with:
#   node scripts/security/google-signin-origin-probe.mjs https://your-domain
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── Where the platforms send users back ─────────────────────────────────────
# The redirect URIs above are built from NEXT_PUBLIC_APP_URL (Section 1, and
# it is already declared there — do not add a second copy). Platforms match
# redirect URIs EXACTLY against an allowlist, so that value must equal the
# origin the browser is actually on: no trailing slash, and never a Vercel
# preview URL — those rotate per deploy and will 404 mid-review.
#   Local:      http://localhost:3000
#   Production: https://your-domain

# ── Error tracking (LOCK L0.4) ────────────────────────────────────────────
# The DSN is public by design (client-bundle inlined, send-only). Without it
# the SDK no-ops silently, which is the failure mode this lock exists to end.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# The edge functions read the UNPREFIXED names, because NEXT_PUBLIC_* is a
# Next.js build-time convention that means nothing inside Deno. Set both, in
# both places: this one in Vercel, and SENTRY_DSN / SENTRY_ENVIRONMENT in
# `supabase secrets`. Missing them is silent by design — the reporter no-ops
# rather than throwing — which is exactly why they need writing down.
SENTRY_DSN=""                # same DSN, for supabase/functions/_shared/sentry.ts
SENTRY_ENVIRONMENT=""        # e.g. "production" — tags edge events
# Optional: needed only for source-map upload at build time.
SENTRY_AUTH_TOKEN=""

# ── Deployment version signals — INJECTED, do not set by hand ──────────────
# These are how each surface answers "which commit am I running?" without
# anyone needing a credential. Before they existed the only way to tell was to
# compare deploy timestamps against git, and on 2026-09-01 that inference
# wrongly reported a security fix as undeployed.
#
# Verify at any time:
#   curl -s https://brandosse1.vercel.app/api/health | jq -r .git_sha
#   curl -s https://brandosse-video-worker.fly.dev/health | jq -r .git_sha
#   git rev-parse HEAD
#
# VERCEL_GIT_COMMIT_SHA=""           # Injected by Vercel at build time.
# VERCEL_GIT_COMMIT_REF=""           # Injected by Vercel — the branch.
# WORKER_GIT_SHA=""                  # Baked into the worker image by the
#                                    # Dockerfile from --build-arg GIT_SHA,
#                                    # passed by deploy-worker.yml. Reads
#                                    # "unknown" on a local docker build.
